<?xml version="1.0" encoding="utf-8"?>
<!-- Test packages come from nuget.org only, independent of any machine-wide private feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
